# Copia a fabrica/.env (NO se sube a git).

# Backend al que se registra cada matera
FABRICA_API=http://localhost:5000

# Debe ser IGUAL a FABRICA_CLAVE del backend/.env
FABRICA_CLAVE=

# --- Lo que se graba en el firmware de cada ESP32 (salida/<CODIGO>.h) ---
# Servidor al que se conecta el ESP32 por WebSocket: IP del PC en la red, NO localhost
ESP_SERVIDOR=192.168.1.50:5000

# WiFi al que se conecta el ESP32 (versión de demo: queda fijo en el firmware)
ESP_WIFI_SSID=
ESP_WIFI_CLAVE=
