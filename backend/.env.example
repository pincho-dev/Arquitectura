# Copia este archivo a .env (NO subas .env al repo) y completa los valores reales.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_PORT=5000

# CORS: origen desde el que se sirve el front (RA7)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Base de datos PostgreSQL (docker compose up -d en la raíz del repo)
DATABASE_URL=postgresql+psycopg://matera:matera@localhost:5432/matera

# Tabla de referencia de especies (R4): "csv" o "bd". Se cambia aquí, sin tocar código.
TABLA_REFERENCIA=csv

# Secreto para firmar los JWT. Solo vive en el servidor, nunca en el repo.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Minutos de validez del token de acceso del usuario
JWT_MINUTOS_VALIDEZ=60

# URL del front que se graba en los stickers NFC (usar la IP de la red local para probar desde el teléfono)
FRONT_URL=http://localhost:5500

# --- Tiempo real (WebSockets) ---
# Cada cuántos segundos el servidor hace ping a cada WebSocket; sin respuesta, se cierra.
WS_PING_S=20
# Cada cuántos segundos el ESP32 manda una lectura (se lo dice el backend al conectarse).
ESP_INTERVALO_S=10

# Clave de la estación de fábrica (fabrica/estacion.py, cabecera X-Fabrica-Clave).
# Vacía = la API de fábrica queda deshabilitada. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
FABRICA_CLAVE=
