# Copia este archivo a .env (NO subas .env al repo) y completa los valores reales.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_PORT=5000

# CORS: origen desde el que se sirve el front (RA7)
CORS_ORIGIN=http://localhost:5500

# Base de datos PostgreSQL (docker compose up -d en la raíz del repo)
DATABASE_URL=postgresql+psycopg://matera:matera@localhost:5432/matera

# Tabla de referencia de especies (R4): "csv" o "bd". Se cambia aquí, sin tocar código.
TABLA_REFERENCIA=csv

# Secreto para firmar los JWT. Solo vive en el servidor, nunca en el repo.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Minutos de validez del token de acceso del usuario
JWT_MINUTOS_VALIDEZ=60
